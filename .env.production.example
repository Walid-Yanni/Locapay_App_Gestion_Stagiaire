# Copier vers .env.production (ignoré par git) et remplir. Ne JAMAIS commiter .env.production.
# Générer chaque secret avec :  openssl rand -hex 32

# Mot de passe de la base (hexadécimal : pas de caractères spéciaux, il est inséré dans une URL).
POSTGRES_PASSWORD=

# Secrets de signature des jetons : deux valeurs DIFFÉRENTES, 32 caractères minimum.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Adresse publique du site, exactement telle que saisie dans le navigateur (https, sans / final).
WEB_ORIGIN=https://stagiaires.exemple.bj

# Nombre de proxys entre Internet et l'API : 1 = nginx du conteneur seul ;
# 2 = un reverse proxy du VPS devant (cas habituel avec TLS).
TRUST_PROXY=2

# Port local sur lequel écoute le conteneur web (le reverse proxy du VPS pointe dessus).
WEB_PORT=8080
