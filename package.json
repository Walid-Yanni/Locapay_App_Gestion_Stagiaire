{
  "name": "locapay-stagiaires",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo LOCAPAY Gestion des Stagiaires",
  "scripts": {
    "dev": "pnpm --parallel --filter @locapay/api --filter @locapay/web dev",
    "dev:api": "pnpm --filter @locapay/api dev",
    "dev:web": "pnpm --filter @locapay/web dev",
    "dev:mobile": "pnpm --filter @locapay/mobile start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "seed": "pnpm --filter @locapay/api prisma:seed"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
